{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && (auth.uid == $uid || (data.exists() && newData.exists() && newData.child('honeydew').val() > data.child('honeydew').val() && newData.child('username').val() == data.child('username').val() && newData.child('displayName').val() == data.child('displayName').val() && newData.child('level').val() == data.child('level').val() && newData.child('xp').val() == data.child('xp').val()))",
        "honeydew": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },
    "farms": {
      ".indexOn": ["userId"],
      "$farmId": {
        ".read": "auth != null && data.child('userId').val() == auth.uid",
        ".write": "auth != null && (newData.child('userId').val() == auth.uid || data.child('userId').val() == auth.uid)"
      }
    },
    "queens": {
      ".indexOn": ["userId"],
      "$queenId": {
        ".read": "auth != null && (data.child('userId').val() == auth.uid || data.child('forSale').val() == true)",
        ".write": "auth != null && (newData.child('userId').val() == auth.uid || data.child('userId').val() == auth.uid)"
      }
    },
    "marketListings": {
      ".indexOn": ["createdAt"],
      "$listingId": {
        ".read": "auth != null",
        ".write": "auth != null && (data.child('sellerId').val() == auth.uid || newData.child('sellerId').val() == auth.uid || (data.exists() && (!newData.exists() || newData.child('buyerId').val() == auth.uid)))"
      }
    },
    "communityPosts": {
      ".indexOn": ["createdAt"],
      "$postId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "comments": {
      "$postId": {
        ".indexOn": ["createdAt"],
        "$commentId": {
          ".read": "auth != null",
          ".write": "auth != null && (newData.child('userId').val() == auth.uid || data.child('userId').val() == auth.uid)"
        }
      }
    },
    "notifications": {
      "$userId": {
        ".indexOn": ["createdAt"],
        "$notificationId": {
          ".read": "auth != null && auth.uid == $userId",
          ".write": "auth != null && (auth.uid == $userId || newData.child('userId').val() == auth.uid)"
        }
      }
    }
  }
}
